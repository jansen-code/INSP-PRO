<?xml version="1.0" encoding="utf-8"?>
<!--
    Chip de destaque do botão de Proporção (ex.: "3:4"). Usa o laranja
    #F97316 da identidade visual do INSPETOR para diferenciá-lo como o
    controle principal dentro do grupo da topbar.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F97316" />
    <corners android:radius="999dp" />
</shape>
