<?xml version="1.0" encoding="utf-8"?>
<!--
    Círculo branco interno onde a logo fica em cima.
    Usa um leve gradiente claro pra dar profundidade, igual ao mockup.
    Coloque em: app/src/main/res/drawable/bg_logo_inner_circle.xml
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="120dp"
        android:startColor="#FFFFFF"
        android:endColor="#F3F4F6" />
    <stroke
        android:width="1dp"
        android:color="#E5E7EB" />
</shape>
