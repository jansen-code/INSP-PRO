<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_campo_na.xml  (res/drawable/)
    Retângulo com cantos levemente arredondados e borda branca/cinza claro.
    Usado na box "DIGITE O N.A." do dialog de resultado N.A.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fundo levemente acinzentado -->
    <solid android:color="#F8FAFC"/>

    <!-- Borda branca / cinza claro conforme especificado -->
    <stroke
        android:width="1.5dp"
        android:color="#CBD5E1"/>

    <!-- Cantos quase quadrados (raio mínimo = 4dp) -->
    <corners android:radius="4dp"/>

</shape>
