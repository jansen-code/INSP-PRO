<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollDialogHistorico"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#FFFFFF"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEditTipo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DET-01"
                        android:textColor="#2563EB"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="2dp"/>

                    <LinearLayout
                        android:id="@+id/btnEditarNomeLugar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingEnd="6dp"
                        android:paddingVertical="2dp">

                        <TextView
                            android:id="@+id/tvEditSubtitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HM-01"
                            android:textColor="#0F172A"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                        <ImageView
                            android:id="@+id/iconEditSubtitulo"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_registro_pen"
                            app:tint="#2563EB"
                            android:visibility="gone"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" • "
                            android:textColor="#94A3B8"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/tvEditDataHora"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="13.06.2026 // 07:46h"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnFecharDialog"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#94A3B8"
                    android:padding="8dp"
                    android:layout_marginStart="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/frameImagemHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp">

                <ImageView
                    android:id="@+id/imgFotoSuperior"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"/>

                <ImageView
                    android:id="@+id/imgFotoOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />

                <com.raylson.jansen.inspetor.ReguaVerticalView
                    android:id="@+id/reguaEdicaoDialogHistorico"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_gravity="top"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvLabelFotoSup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="#CC0F172A"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="FLOWMETER"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvZoomLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="#CC0F172A"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="100%"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/layoutToggles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <Button
                    android:id="@+id/btnToggleSuperior"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#2563EB"
                    android:text="LIGADO"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnToggleInferior"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#2563EB"
                    android:text="DESLIGADA"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutEditNA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingHorizontal="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VALOR DO N.A."
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="2dp"/>

                <EditText
                    android:id="@+id/etEditValorNA"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@null"
                    android:hint="00.00m"
                    android:inputType="number"
                    android:textColor="#0F172A"
                    android:textColorHint="#CBD5E1"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:paddingBottom="2dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:background="#E2E8F0"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linhaBotoesHistorico"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBtnHoraHistorico"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#F97316"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/btnEditarHoraHistorico"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="13dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Editar data e hora"
                        android:src="@android:drawable/ic_menu_recent_history"
                        app:tint="#FFFFFF" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#2563EB"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <Button
                        android:id="@+id/btnSalvarBaixar"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="4dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:text="BAIXAR"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#EFF6FF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <Button
                        android:id="@+id/btnCompartilhar"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="4dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:text="COMPARTILHAR"
                        android:textColor="#2563EB"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/overlayEdicaoLugar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#C0000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="85dp"
            android:layout_marginHorizontal="18dp"
            android:orientation="vertical"
            android:background="@drawable/bg_input_rounded"
            android:backgroundTint="#FFFFFF"
            android:padding="16dp"
            android:elevation="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORRIGIR LOCAL DO N.A."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerOpcoesLugares"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"/>

        </LinearLayout>
    </FrameLayout>
</FrameLayout>
