<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    android:fitsSystemWindows="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FB">

    <LinearLayout
    android:id="@+id/header"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <!-- CardView agora tem o ID btnVoltar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnVoltar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Voltar"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#0F172A" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-black"
        android:text="Configurações"
        android:textColor="#0F172A"
        android:textSize="26sp"
        android:textStyle="bold" />
</LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btnSalvar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Formato da Câmera"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Essa configuração vale apenas para: ARB-05, ARB-06, ARB-07 e N.A."
                        android:textColor="#64748B"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="A foto continua sendo tirada normalmente. Depois da captura, o app aplica o enquadramento escolhido apenas nas estações compatíveis."
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <!-- ══ NOVO: opção 4:5 — proporção padrão ══ -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardOption4x5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:cardBackgroundColor="#F8FAFC"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                            <RadioButton
                                android:id="@+id/radio_4x5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:buttonTint="#2563EB"
                                android:checked="true"
                                android:clickable="false"
                                android:focusable="false"
                                android:duplicateParentState="false"
                                android:gravity="center_vertical"
                                android:minHeight="60dp"
                                android:paddingStart="16dp"
                                android:paddingTop="16dp"
                                android:paddingEnd="16dp"
                                android:paddingBottom="16dp"
                                android:text="4:5 (Vertical - Padrão)"
                                android:textColor="#0F172A"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardOption3x4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:cardBackgroundColor="#F8FAFC"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                            <RadioButton
                                android:id="@+id/radio_3x4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:buttonTint="#2563EB"
                                android:checked="false"
                                android:clickable="false"
                                android:focusable="false"
                                android:duplicateParentState="false"
                                android:gravity="center_vertical"
                                android:minHeight="60dp"
                                android:paddingStart="16dp"
                                android:paddingTop="16dp"
                                android:paddingEnd="16dp"
                                android:paddingBottom="16dp"
                                android:text="3:4 (Vertical - Recomendado)"
                                android:textColor="#0F172A"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardOption9x16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:cardBackgroundColor="#F8FAFC"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                            <RadioButton
                                android:id="@+id/radio_9x16"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:buttonTint="#2563EB"
                                android:clickable="false"
                                android:focusable="false"
                                android:duplicateParentState="false"
                                android:gravity="center_vertical"
                                android:minHeight="60dp"
                                android:paddingStart="16dp"
                                android:paddingTop="16dp"
                                android:paddingEnd="16dp"
                                android:paddingBottom="16dp"
                                android:text="9:16 (Vertical - Tela cheia)"
                                android:textColor="#0F172A"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardOption1x1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:cardBackgroundColor="#F8FAFC"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                            <RadioButton
                                android:id="@+id/radio_1x1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:buttonTint="#2563EB"
                                android:clickable="false"
                                android:focusable="false"
                                android:duplicateParentState="false"
                                android:gravity="center_vertical"
                                android:minHeight="60dp"
                                android:paddingStart="16dp"
                                android:paddingTop="16dp"
                                android:paddingEnd="16dp"
                                android:paddingBottom="16dp"
                                android:text="1:1 (Quadrado)"
                                android:textColor="#0F172A"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardOptionFull"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#F8FAFC"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                            <RadioButton
                                android:id="@+id/radio_full"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:buttonTint="#2563EB"
                                android:clickable="false"
                                android:focusable="false"
                                android:duplicateParentState="false"
                                android:gravity="center_vertical"
                                android:minHeight="60dp"
                                android:paddingStart="16dp"
                                android:paddingTop="16dp"
                                android:paddingEnd="16dp"
                                android:paddingBottom="16dp"
                                android:text="Full (Proporção original do celular)"
                                android:textColor="#0F172A"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/btnSalvar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#2563EB"
        app:cardCornerRadius="18dp"
        app:cardElevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="Salvar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
