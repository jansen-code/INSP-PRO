<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    android:fitsSystemWindows="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/bg_header_cofre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#2563EB"
            app:cardCornerRadius="30dp"
            app:cardElevation="10dp"
            app:cardUseCompatPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="22dp">

                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:alpha="0.12"
                    android:background="#FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.08"
                    android:background="#FFFFFF"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:id="@+id/btnVoltarCofre"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_circle_back_outlined"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvTituloCofre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:fontFamily="@font/app_font_ui_black"
                    android:maxLines="1"
                    android:text="GALERIA 2"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="24sp"
                    app:autoSizeMinTextSize="16sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toStartOf="@id/linha_topo_direita_cofre"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnVoltarCofre" />

                <View
                    android:id="@+id/linha_topo_esquerda_cofre"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:alpha="0.80"
                    android:background="#FFFFFF"
                    app:layout_constraintBottom_toBottomOf="@id/tvTituloCofre"
                    app:layout_constraintEnd_toStartOf="@id/tvTituloCofre"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvTituloCofre" />

                <View
                    android:id="@+id/linha_topo_direita_cofre"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_marginStart="12dp"
                    android:alpha="0.80"
                    android:background="#FFFFFF"
                    app:layout_constraintBottom_toBottomOf="@id/tvTituloCofre"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvTituloCofre"
                    app:layout_constraintTop_toTopOf="@id/tvTituloCofre" />

                <TextView
                    android:id="@+id/tvSubtituloCofre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Fotos limpas organizadas por estação"
                    android:textColor="#DBEAFE"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tvTituloCofre"
                    app:layout_constraintTop_toBottomOf="@id/tvTituloCofre" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══════════════════════════════════════════════════════════════
             NOVO: os 3 "botões de seleção" (DET-01 / N.A. / ARB'S) no lugar
             das antigas pastas clicáveis. Ficam bem próximos um do outro,
             delicados (retangulares, mais baixos que as pastas antigas),
             mesmas cores (verde/vermelho/laranja), sem ícone de pasta.
             Tocar em um troca o grupo exibido embaixo, na MESMA tela — não
             existe mais "entrar" numa pasta. N.A. começa selecionado.
             ═══════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/linhaSeletorGruposCofre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bg_header_cofre">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnGrupoDet01Cofre"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#16A34A"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNomeGrupoDet01Cofre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DET-01"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/tvQtdGrupoDet01Cofre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 fotos"
                        android:textColor="#E6FFFFFF"
                        android:textSize="10sp"
                        android:maxLines="1" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnGrupoNaCofre"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#DC2626"
                app:cardCornerRadius="13dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNomeGrupoNaCofre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="N.A."
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/tvQtdGrupoNaCofre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 fotos"
                        android:textColor="#E6FFFFFF"
                        android:textSize="10sp"
                        android:maxLines="1" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnGrupoArbsCofre"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#F97316"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNomeGrupoArbsCofre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ARB'S"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/tvQtdGrupoArbsCofre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 fotos"
                        android:textColor="#E6FFFFFF"
                        android:textSize="10sp"
                        android:maxLines="1" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCofre"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="true"
            android:overScrollMode="never"
            android:paddingTop="26dp"
            android:paddingBottom="110dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linhaSeletorGruposCofre" />

        <!-- ═══ Máscara opaca: cobre a faixa entre os botões seletores e a
             linha de corte. Qualquer foto que suba por trás dela some de
             forma seca — as fotos não passam dos botões de seleção. ═══ -->
        <View
            android:id="@+id/viewMascaraCorteCofre"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:background="#F8FAFC"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linhaSeletorGruposCofre" />

        <LinearLayout
            android:id="@+id/layoutVazioCofre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linhaSeletorGruposCofre">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.35"
                android:src="@drawable/ic_pasta_cofre" />

            <TextView
                android:id="@+id/tvVazioCofre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Nenhuma foto aqui ainda"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBarCofre"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        app:backgroundTint="@android:color/white"
        app:contentInsetEnd="0dp"
        app:paddingBottomSystemWindowInsets="false"
        
        app:contentInsetStart="0dp"
        app:elevation="12dp"
        app:fabCradleMargin="10dp"
        app:fabCradleRoundedCornerRadius="18dp"
        app:fabCradleVerticalOffset="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnHistoricoCofre"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="#64748B" />
                <TextView
                    android:id="@+id/tvTextoAcaoPrincipalCofre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Histórico"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSelecionarTudoCofre"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/checkbox_off_background"
                    app:tint="#64748B" />
                <TextView
                    android:id="@+id/tvTextoSelecionarTudoCofre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Limpar"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>

            <LinearLayout
                android:id="@+id/btnCompartilharCofre"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/imgIconEnviarCofre"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="#2563EB" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Enviar"
                    android:textColor="#2563EB"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnExcluirSelecaoCofre"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/imgIconExcluirCofre"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#EF4444" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Excluir"
                    android:textColor="#EF4444"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.bottomappbar.BottomAppBar>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnFecharCofreFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Fechar"
        app:layout_anchor="@id/bottomAppBarCofre"
        app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="@android:color/white"
        app:backgroundTint="#2563EB"
        app:elevation="6dp"
        app:maxImageSize="26dp"
        app:fabCustomSize="56dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
