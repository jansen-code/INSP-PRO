<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Card azul: bomba + toggle -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#2563EB"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="#1D4ED8">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_compass"
                    android:tint="#93C5FD"
                    android:padding="12dp"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/tvHeaderCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DET-01"
                    android:textColor="#BFDBFE"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"/>
                <TextView
                    android:id="@+id/tvBombaCorrespondente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DET-01"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="52dp"
                android:background="#3B82F6"
                android:layout_marginEnd="14dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS"
                    android:textColor="#BFDBFE"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>
                <ToggleButton
                    android:id="@+id/toggleStatus"
                    android:layout_width="72dp"
                    android:layout_height="32dp"
                    android:textOn="ON"
                    android:textOff="OFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_toggle_off"
                    android:checked="false"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Label: Registros Recentes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tvSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REGISTROS RECENTES"
            android:textColor="#5A6478"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#252B38"
            android:layout_marginStart="10dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver Todos"
            android:textColor="#2563EB"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginStart="10dp"/>
    </LinearLayout>

</LinearLayout>
