<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════════
     dialog_edicao_manual_lista.xml
     Diálogo de EDIÇÃO MANUAL RÁPIDA — aberto por duplo toque em um card
     da ListaNAActivity (N.A. ou FLW/HIDRO, conforme o modo ativo).

     Reaproveita a MESMA linguagem visual do dialog_leitura_manual.xml
     (cores, tipografia, cards F1F5F9, botão azul #2563EB, letterSpacing
     nos labels) só que no formato "card popup" do dialog_editar_data_hora.xml,
     pois aqui não existe foto associada — apenas 3 campos rápidos.
     ════════════════════════════════════════════════════════════════════ -->
<androidx.cardview.widget.CardView
    
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="28dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp">

        <!-- ═══ Cabeçalho: título + botão Restaurar Original ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EDIÇÃO MANUAL"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:id="@+id/tvTituloEdicaoManual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Local"
                    android:textColor="#1E293B"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnRestaurarOriginalLista"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_circle_back_outlined"
                android:contentDescription="Restaurar original"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#2563EB" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubtituloEdicaoManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Você poderá restaurar para PENDENTE"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp" />

        <!-- ═══ VALOR (N.A. ou leitura, conforme o modo) ═══ -->
        <TextView
            android:id="@+id/tvLabelValorEdicao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VALOR N.A."
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#F1F5F9"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="18dp">

            <EditText
                android:id="@+id/etValorEdicaoLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:hint="00.00m"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLines="1"
                android:padding="16dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="22sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- ═══ DATA ═══ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DATA"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDataEdicaoLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="DD.MM.AAAA"
            android:inputType="number"
            android:maxLength="10"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginBottom="16dp" />

        <!-- ═══ HORA ═══ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HORA"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etHoraEdicaoLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="HH:mm"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginBottom="22dp" />

        <!-- ═══ Ações ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#EFF6FF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <Button
                    android:id="@+id/btnCancelarEdicaoLista"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingVertical="13dp"
                    android:text="CANCELAR"
                    android:textColor="#2563EB"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#2563EB"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <Button
                    android:id="@+id/btnSalvarEdicaoLista"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingVertical="13dp"
                    android:text="SALVAR"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>