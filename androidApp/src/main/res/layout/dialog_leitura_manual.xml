<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════════
     dialog_leitura_manual.xml
     Diálogo de Leitura Manual (HM / HM_VAZAO / DET-01)
     Acionado pelo duplo clique no boxHidrometro quando há foto.

     PADRONIZADO no mesmo tamanho/estrutura do diálogo de N.A.
     (tela cheia: MATCH_PARENT / MATCH_PARENT), com a foto preenchendo
     o topo via centerCrop (sem bordas pretas) e um painel inferior
     com os campos de leitura + o toggle "ADICIONAR DADOS DA TELA?".
     ════════════════════════════════════════════════════════════════════ -->
<androidx.constraintlayout.widget.ConstraintLayout
    
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ═══ FOTO (ocupa o topo da tela, igual ao diálogo de N.A.) ═══ -->
    <ImageView
        android:id="@+id/imgLMFoto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Foto capturada"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/painelLM"
        app:layout_constraintHeight_percent="0.42" />

    <!-- Selo de zoom (canto superior direito, sobre a foto) -->
    <TextView
        android:id="@+id/tvLMZoomLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="#80000000"
        android:fontFamily="@font/app_font_ui_medium"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="100%"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        app:layout_constraintTop_toTopOf="@id/imgLMFoto"
        app:layout_constraintEnd_toEndOf="@id/imgLMFoto" />

    <!-- Botão fechar (canto superior esquerdo, sobre a foto) -->
    <ImageView
        android:id="@+id/btnFecharLM"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="10dp"
        android:background="@drawable/bg_circle_back_outlined"
        android:clickable="true"
        android:contentDescription="Fechar"
        android:focusable="true"
        android:padding="9dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintTop_toTopOf="@id/imgLMFoto"
        app:layout_constraintStart_toStartOf="@id/imgLMFoto"
        app:tint="#FFFFFF" />

    <!-- ═══ PAINEL INFERIOR (rolável, contém os campos) ═══ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/painelLM"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/imgLMFoto"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="26dp">

            <!-- Alça visual do painel -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginBottom="16dp"
                android:layout_gravity="center_horizontal"
                android:background="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="LEITURA MANUAL"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLMTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/app_font_ui_medium"
                android:text="Informe o valor lido"
                android:textColor="#1E293B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Hint do tipo (HM ou HM_VAZAO) -->
            <TextView
                android:id="@+id/tvLMHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Digite o valor lido (use ponto para decimal)"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <!-- Campo de leitura -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#F1F5F9"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <EditText
                    android:id="@+id/etLeituraManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/app_font_ui_medium"
                    android:hint="0.00"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <!-- Preview do valor formatado (mantido oculto pelo Kotlin) -->
            <TextView
                android:id="@+id/tvLMPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/app_font_ui_medium"
                android:gravity="center"
                android:text=" "
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- ═══════════════════════════════════════════════════════════
                 NOVO (movido do dialog_vazao.xml):
                 "ADICIONAR DADOS DA TELA?"  SIM / NÃO
                 Inicia DESATIVADO — só libera quando houver valor digitado
                 no etLeituraManual (checagem feita no TextWatcher).
                 ═══════════════════════════════════════════════════════════ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="#EEF2F6" />

            <LinearLayout
                android:id="@+id/blocoIncluirLM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="ADICIONAR DADOS DA TELA?"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/toggleIncluirNaoLM"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:clickable="false"
                        android:focusable="false"
                        app:cardBackgroundColor="#F1F5F9"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvToggleIncluirNaoLM"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:letterSpacing="0.05"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="NÃO"
                            android:textColor="#94A3B8"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/toggleIncluirSimLM"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:clickable="false"
                        android:focusable="false"
                        app:cardBackgroundColor="#F1F5F9"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvToggleIncluirSimLM"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:letterSpacing="0.05"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="SIM"
                            android:textColor="#94A3B8"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAvisoIncluirLM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Digite um valor acima para liberar esta opção."
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Botão SALVAR DADOS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnSalvarLM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="#EFF6FF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/app_font_ui_black"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="SALVAR DADOS"
                    android:textColor="#2563EB"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
