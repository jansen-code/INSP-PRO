<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    android:fitsSystemWindows="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ═══ Carrossel: RecyclerView horizontal com "snap" de página (uma
         foto por vez), permite arrastar pro lado/outro para folhear as
         fotos do grupo, com zoom/pan individual em cada uma. ═══ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerVisualizadorCofre"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never" />

    <!-- ═══ Barra superior — botões circulares translúcidos, mesmo padrão
         de badge redondo usado no resto do app ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp"
        android:background="#66000000">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnFecharVisualizador"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#40000000"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Fechar"
                app:tint="#FFFFFF" />
        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <androidx.cardview.widget.CardView
            android:id="@+id/btnCompartilharVisualizador"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#40000000"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_share"
                android:contentDescription="Compartilhar"
                app:tint="#FFFFFF" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnExcluirVisualizador"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#EF4444"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="Excluir"
                app:tint="#FFFFFF" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- ═══ Rodapé — rótulo (numeração/estrutura/data-hora) da foto ATUAL
         do carrossel, e (só em modo de escolha) o botão PEGAR IMAGEM
         logo abaixo, pra confirmar a foto exibida no momento. ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#66000000">

        <TextView
            android:id="@+id/tvRotuloVisualizador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="1. N.A - 05.07.2026 14:30h"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:id="@+id/btnPegarImagemVisualizador"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#2563EB"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✓  PEGAR IMAGEM"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:letterSpacing="0.03" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</FrameLayout>
