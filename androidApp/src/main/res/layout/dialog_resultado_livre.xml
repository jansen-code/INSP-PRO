<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollDialogLV"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ TOP BAR ═══ -->
        <LinearLayout
            android:id="@+id/topBarDialogLV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">
                
                <!-- Monitoramento Livre agora em Cinza e um pouco maior -->
                <TextView
                    android:id="@+id/tvLVLabelDialogLV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MONITORAMENTO LIVRE"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnFecharDialogLV"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#94A3B8"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ═══ FRAME DA FOTO E RÉGUA DA LUZ ═══ -->
        <FrameLayout
            android:id="@+id/frameImagemLV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">

            <ImageView
                android:id="@+id/imgResultadoLV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/imgResultadoOverlayLV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />

            <com.raylson.jansen.inspetor.ReguaVerticalView
                android:id="@+id/reguaEdicaoDialogLV"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="top" />

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ═══ PAINEL INFERIOR ═══ -->
        <LinearLayout
            android:id="@+id/layoutBotoesInferioresLV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingBottom="16dp">

            <View
                android:id="@+id/dividerLV"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/blocoTextoLV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        app:cardBackgroundColor="#EFF6FF"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvZoomLevelLV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="100%"
                            android:textColor="#2563EB"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </androidx.cardview.widget.CardView>
                </RelativeLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#F1F5F9"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/etTextoLivre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/app_font_ui_medium"
                        android:gravity="top|start"
                        android:hint="Digite aqui!"
                        android:imeOptions="actionNone|flagNoEnterAction"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="6"
                        android:minLines="2"
                        android:padding="16dp"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="16sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="ADICIONAR DATA E HORA?"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/toggleDataHoraNao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#F1F5F9"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvToggleDataHoraNao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:letterSpacing="0.05"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="NÃO"
                            android:textColor="#94A3B8"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/toggleDataHoraSim"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#16A34A"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvToggleDataHoraSim"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:letterSpacing="0.05"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="SIM"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>

            <!-- ════════════════════════════════════════════════════════════════
                 LINHA DE BOTÕES INFERIORES (TEMA VERMELHO)
                 ════════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/linhaBotoesLV"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBtnHoraLV"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#EF4444"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/btnEditarHoraLV"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="13dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Editar data e hora"
                        android:src="@android:drawable/ic_menu_recent_history"
                        app:tint="#FFFFFF" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#EF4444"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <Button
                        android:id="@+id/btnBaixarLV"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="4dp"
                        android:gravity="center"
                        android:fontFamily="@font/app_font_ui_medium"
                        android:letterSpacing="0.01"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeStepGranularity="1sp"
                        android:text="BAIXAR"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FEF2F2"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <Button
                        android:id="@+id/btnCompartilharLV"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="4dp"
                        android:gravity="center"
                        android:fontFamily="@font/app_font_ui_medium"
                        android:letterSpacing="0.01"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeStepGranularity="1sp"
                        android:text="COMPARTILHAR"
                        android:textColor="#EF4444"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
