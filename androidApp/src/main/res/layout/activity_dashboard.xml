<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    
    android:fitsSystemWindows="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FB">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="68dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tvSaudacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boa tarde,"
                        android:textSize="22sp"
                        android:textColor="#111827"
                        android:fontFamily="@font/app_font_ui_medium"
                        android:layout_marginEnd="6dp"/>

                                        <TextView
                        android:id="@+id/tvApelido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Raylson"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8"  android:fontFamily="@font/app_font_ui_black"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/btnConfiguracoes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Configurações"
                        android:padding="6dp"
                        android:src="@drawable/ic_logo_saneamento"
                        app:tint="#2563EB" android:scaleType="centerInside" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="#2563EB"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="96dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgRaio"
                        android:layout_width="42dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_raio"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvCardAzulSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="BOMBA CORRESPONDENTE"
                            android:textColor="#BFDBFE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/app_font_ui_medium"
                            android:letterSpacing="0.04"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeMaxTextSize="11sp"/>

                        <TextView
                            android:id="@+id/tvBombaCorrespondente"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="BOMBA-01"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/app_font_ui_black"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="14sp"
                            android:autoSizeMaxTextSize="24sp"
                            android:autoSizeStepGranularity="1sp"/>

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="56dp"
                        android:background="#FFFFFF"
                        android:alpha="0.45"
                        android:layout_marginHorizontal="14dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STATUS"
                            android:textColor="#BFDBFE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/app_font_ui_medium"
                            android:letterSpacing="0.06"
                            android:gravity="center"
                            android:layout_marginBottom="6dp"/>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnStatus"
                            android:layout_width="44dp" 
                            android:layout_height="44dp"
                            app:cardCornerRadius="12dp" app:cardElevation="0dp"
                            app:cardBackgroundColor="#22C55E" android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/imgStatus"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="10dp"
                                android:src="@drawable/ic_power"
                                app:tint="#FFFFFF" android:scaleType="centerInside"/>

                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/tvLabelCarrossel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="SELECIONE O PONTO DE MONITORAMENTO"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/carrosselHidrometros"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="4dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="14dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/boxHidrometro"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="10dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvLabelHidro"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HIDRÔMETRO"
                                android:textColor="#94A3B8"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="9sp"
                                android:autoSizeMaxTextSize="11sp"
                                android:layout_marginBottom="10dp"/>

                            <FrameLayout
                                android:id="@+id/frameImgHidro"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1">

                                <ImageView
                                    android:id="@+id/imgHidroIcon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_camera_outline"
                                    android:scaleType="centerInside"/>

                                <ImageView
                                    android:id="@+id/imgHidroPreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone"/>

                                <!-- ═══ Badge elegante para apagar individualmente a foto ═══ -->
                                <androidx.cardview.widget.CardView
                                    android:id="@+id/btnDeletarHidro"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="top|end"
                                    android:layout_margin="6dp"
                                    android:visibility="gone"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="4dp"
                                    app:cardBackgroundColor="#EF4444">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:padding="5dp"
                                        android:contentDescription="Apagar foto"
                                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                                        app:tint="#FFFFFF" />
                                </androidx.cardview.widget.CardView>

                            </FrameLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#E2E8F0"/>

                        <LinearLayout
                            android:id="@+id/boxBomba"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="10dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvLabelBomba"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BOMBA"
                                android:textColor="#94A3B8"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="9sp"
                                android:autoSizeMaxTextSize="11sp"
                                android:layout_marginBottom="10dp"/>

                            <FrameLayout
                                android:id="@+id/frameImgBomba"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1">

                                <ImageView
                                    android:id="@+id/imgBombaIcon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_camera_outline"
                                    android:scaleType="centerInside"/>

                                <ImageView
                                    android:id="@+id/imgBombaPreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone"/>

                                <!-- ═══ Badge elegante para apagar individualmente a foto ═══ -->
                                <androidx.cardview.widget.CardView
                                    android:id="@+id/btnDeletarBomba"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="top|end"
                                    android:layout_margin="6dp"
                                    android:visibility="gone"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="4dp"
                                    app:cardBackgroundColor="#EF4444">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:padding="5dp"
                                        android:contentDescription="Apagar foto"
                                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                                        app:tint="#FFFFFF" />
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/btnToggleForaNA"
                                    android:layout_width="80dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="center"
                                    app:cardCornerRadius="18dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="#22C55E"
                                    android:visibility="gone"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center">

                                        <TextView
                                            android:id="@+id/tvToggleForaNA"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="NÃO"
                                            android:textColor="#FFFFFF"
                                            android:textSize="13sp"
                                            android:textStyle="bold"
                                            android:fontFamily="@font/app_font_ui_black"
                                            android:letterSpacing="0.04"/>

                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:text="ESTAÇÕES ATIVAS"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/carrosselEstacoes"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        app:fabCradleMargin="10dp"
        app:fabCradleRoundedCornerRadius="18dp"
        app:fabCradleVerticalOffset="8dp"
        app:backgroundTint="@android:color/white"
        app:elevation="12dp"
        app:contentInsetStart="0dp"
        app:contentInsetEnd="0dp"
        app:paddingBottomSystemWindowInsets="false"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/btnLimparGeral"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_popup_sync"
                    app:tint="#94A3B8"/>
            </LinearLayout>
            
            <LinearLayout
                android:id="@+id/btnCofre"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/btn_star_big_off" app:tint="#94A3B8"/>
            </LinearLayout>
            
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
            
            <LinearLayout
                android:id="@+id/btnListaNA"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">
                <ImageView 
                    android:layout_width="22dp" 
                    android:layout_height="22dp" 
                    android:src="@drawable/ic_registro_pen" 
                    app:tint="#94A3B8"/>
            </LinearLayout>
            
            <LinearLayout
                android:id="@+id/btnHistorico"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">
                <ImageView 
                    android:layout_width="22dp" 
                    android:layout_height="22dp" 
                    android:src="@android:drawable/ic_menu_recent_history" 
                    app:tint="#94A3B8"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.bottomappbar.BottomAppBar>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Gerar registro"
        app:layout_anchor="@id/bottomAppBar"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="@android:color/white"
        app:backgroundTint="#2563EB"
        app:elevation="6dp"
        app:maxImageSize="26dp"
        app:fabCustomSize="56dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
