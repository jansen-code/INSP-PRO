<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_resultado_sc.xml
    Diálogo de resultado do card "SC" (Scanner de Documentos).

    ═══ SEM ScrollView de propósito ═══
    A tela inteira é um LinearLayout vertical onde `frameImagemSC` tem
    layout_height="0dp" + layout_weight="1" — ou seja, o canvas da foto
    SEMPRE ocupa o espaço que sobrar na tela, não importa o tamanho da
    imagem. A imagem faz "fitCenter" dentro desse espaço fixo. Isso é o
    que evita a rolagem que estava atrapalhando: o card nunca cresce mais
    que a tela, é a foto que se ajusta a ele.

    ═══ Filtros de scanner (ColorMatrix, sem OpenCV/ML Kit) ═══
    3 botões (ORIGINAL / MÁGICA / P&B) trocam qual painel de sliders
    aparece embaixo. Nada de intensidade fixa — o usuário arrasta e
    decide o quanto quer de cada efeito, com prévia ao vivo.

    IDs usados pelo DashboardActivity.kt (mostrarDialogResultadoSC):
      imgResultadoSC, btnFecharDialogSC, reguaEdicaoDialogSC,
      cardFiltroOriginalSC/btnFiltroOriginalSC,
      cardFiltroMagicoSC/btnFiltroMagicoSC,
      cardFiltroPBSC/btnFiltroPBSC,
      painelSliderMagicoSC, seekContrasteSC, tvContrasteValorSC,
      seekBrilhoSC, tvBrilhoValorSC,
      painelSliderPBSC, seekLimiarPBSC, tvLimiarValorSC,
      btnBaixarSC, btnCompartilharSC
-->
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ═══ TOP BAR ═══ -->
    <LinearLayout
        android:id="@+id/topBarDialogSC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvSCLabelDialogSC"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DOCUMENTO DIGITALIZADO"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <ImageView
            android:id="@+id/btnFecharDialogSC"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#94A3B8"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- ═══ CANVAS FIXO DA FOTO — sempre ocupa o espaço restante, nunca
         estica o diálogo. A foto se ajusta a ele, não o contrário. ═══ -->
    <FrameLayout
        android:id="@+id/frameImagemSC"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="10dp"
        android:background="#F8FAFC">

        <ImageView
            android:id="@+id/imgResultadoSC"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <com.raylson.jansen.inspetor.ReguaVerticalView
            android:id="@+id/reguaEdicaoDialogSC"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="top" />

    </FrameLayout>

    <!-- ═══ PAINEL INFERIOR (altura fixa por conteúdo, nunca some da tela) ═══ -->
    <LinearLayout
        android:id="@+id/layoutBotoesInferioresSC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingBottom="14dp">

        <!-- ════════════════════════════════════════════════════════════
             SELETOR DE FILTRO — ORIGINAL / MÁGICA / P&B
             ════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/linhaFiltrosSC"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardFiltroOriginalSC"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#8B5C29"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">

                <Button
                    android:id="@+id/btnFiltroOriginalSC"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="ORIGINAL"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardFiltroMagicoSC"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#F3ECE2"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">

                <Button
                    android:id="@+id/btnFiltroMagicoSC"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="✨ MÁGICA"
                    android:textColor="#8B5C29"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardFiltroPBSC"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#F3ECE2"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">

                <Button
                    android:id="@+id/btnFiltroPBSC"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="◐ P&amp;B"
                    android:textColor="#8B5C29"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ════════════════════════════════════════════════════════════
             PAINEL DE SLIDERS — MÁGICA (contraste + brilho ajustáveis)
             Some/aparece conforme o filtro escolhido.
             ════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/painelSliderMagicoSC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CONTRASTE"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvContrasteValorSC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#8B5C29"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekContrasteSC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="30"
                android:progressTint="#8B5C29"
                android:thumbTint="#8B5C29" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BRILHO"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvBrilhoValorSC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#8B5C29"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBrilhoSC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="20"
                android:progressTint="#8B5C29"
                android:thumbTint="#8B5C29"
                android:layout_marginBottom="4dp" />
        </LinearLayout>

        <!-- ════════════════════════════════════════════════════════════
             PAINEL DE SLIDER — P&B (limiar ajustável)
             ════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/painelSliderPBSC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LIMIAR (P&amp;B)"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvLimiarValorSC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150"
                    android:textColor="#8B5C29"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekLimiarPBSC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="150"
                android:progressTint="#8B5C29"
                android:thumbTint="#8B5C29"
                android:layout_marginBottom="4dp" />
        </LinearLayout>

        <View
            android:id="@+id/dividerSC"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp" />

        <!-- ════════════════════════════════════════════════════════════
             LINHA DE BOTÕES INFERIORES (TEMA MARROM — card SC #8B5C29)
             ════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/linhaBotoesSC"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#8B5C29"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <Button
                    android:id="@+id/btnBaixarSC"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:gravity="center"
                    android:fontFamily="@font/app_font_ui_medium"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeStepGranularity="1sp"
                    android:text="BAIXAR"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cardBackgroundColor="#F3ECE2"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <Button
                    android:id="@+id/btnCompartilharSC"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:gravity="center"
                    android:fontFamily="@font/app_font_ui_medium"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeStepGranularity="1sp"
                    android:text="COMPARTILHAR"
                    android:textColor="#8B5C29"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
