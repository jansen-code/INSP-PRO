<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <RelativeLayout
        android:id="@+id/topBarDialog"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="14dp"
        android:paddingTop="18dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="monospace"
            android:letterSpacing="0.02"
            android:text="IMAGEM FINAL PROCESSADA"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnFecharDialog"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:contentDescription="Fechar"
            android:focusable="true"
            android:padding="3dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#94A3B8" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layoutBotoesSuperiores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBarDialog"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="14dp"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnToggleProporcaoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="#EFF6FF"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvToggleProporcao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:paddingVertical="10dp"
                android:text="◱  4:5"
                android:textColor="#2563EB"
                android:textSize="12sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewImagem"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBotoesInferiores"
        android:layout_below="@id/layoutBotoesSuperiores"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="6dp"
        android:paddingBottom="6dp"
        android:maxHeight="600dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="#000000"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgResultadoLimpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/imgResultadoOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />
            </FrameLayout>

        </androidx.cardview.widget.CardView>
    </androidx.core.widget.NestedScrollView>

    <com.raylson.jansen.inspetor.ReguaVerticalView
        android:id="@+id/reguaEdicaoDialog"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_below="@id/layoutBotoesSuperiores"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="0dp"
        android:layout_marginHorizontal="0dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:paddingHorizontal="0dp" />

    <!-- ════════════════════════════════════════════════════════════════
         LINHA DE BOTÕES INFERIORES — PADRÃO UNIFICADO (52dp)
         Idêntico a dialog_historico_edicao.xml e dialog_resultado_na.xml
         ════════════════════════════════════════════════════════════════ -->
        <LinearLayout
        android:id="@+id/layoutBotoesInferiores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="38dp"
        android:background="#FFFFFF">

        <androidx.cardview.widget.CardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="#F97316"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/btnEditarHora"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="13dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Editar data e hora"
                android:src="@android:drawable/ic_menu_recent_history"
                app:tint="#FFFFFF" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#2563EB"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <Button
                android:id="@+id/btnBaixar"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:text="BAIXAR"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#EFF6FF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <Button
                android:id="@+id/btnCompartilhar"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:text="COMPARTILHAR"
                android:textColor="#2563EB"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</RelativeLayout>
