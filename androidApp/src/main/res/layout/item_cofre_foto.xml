<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardFotoCofre"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgMiniaturaCofre"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Foto do cofre" />
    </androidx.cardview.widget.CardView>

    <!-- ═══ Caixinha de seleção — pequena, quadrada, canto superior direito.
         Só aparece durante o modo de seleção múltipla (toque longo).
         Vazia (contorno cinza) = não selecionada.
         Verde com um "✓" = selecionada.
         Usa um TextView pro tick (em vez de um drawable de sistema) pra
         garantir o mesmo visual em qualquer versão do Android. ═══ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/checkFotoCofre"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_margin="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="6dp"
        app:cardElevation="3dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1.4dp"
        app:layout_constraintEnd_toEndOf="@id/cardFotoCofre"
        app:layout_constraintTop_toTopOf="@id/cardFotoCofre">

        <TextView
            android:id="@+id/tvCheckTickFotoCofre"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvRotuloFotoCofre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="1. N.A - 05.07.2026 14:30h"
        android:textColor="#64748B"
        android:textSize="10.5sp"
        android:lineSpacingExtra="1dp"
        app:layout_constraintEnd_toEndOf="@id/cardFotoCofre"
        app:layout_constraintStart_toStartOf="@id/cardFotoCofre"
        app:layout_constraintTop_toBottomOf="@id/cardFotoCofre" />

</androidx.constraintlayout.widget.ConstraintLayout>