<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    android:fitsSystemWindows="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/bg_header_retangulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@android:color/transparent"
            app:cardBackgroundColor="#2563EB"
            app:cardCornerRadius="30dp"
            app:cardElevation="10dp"
            app:cardUseCompatPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <View
                    android:id="@+id/quadrado_fundo_direito"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:alpha="0.12"
                    android:background="#FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.08"
                    android:background="#FFFFFF"
                    android:layout_marginTop="60dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/btn_back_na"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_circle_back_outlined"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#FFFFFF" />

                <LinearLayout
                    android:id="@+id/layout_titulo_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@id/quadrado_fundo_direito"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_back_na">

                    <TextView
                        android:id="@+id/tvTituloControle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/app_font_ui_black"
                        android:text="CONTROLE N.A."
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:singleLine="true"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="14sp"
                        app:autoSizeMaxTextSize="22sp" />

                    <TextView
                        android:id="@+id/tvSubtituloModo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="ORDEM: INFIELD"
                        android:textColor="#DBEAFE"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- ═══════════════════════════════════════════════════════════════
                     NOVO: Toggle CONTROLE N.A.  ↔  CONTROLE FLW e HIDRO
                     ═══════════════════════════════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnToggleControleTipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_titulo_na">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:src="@android:drawable/stat_notify_sync"
                            app:tint="#2563EB"/>

                        <TextView
                            android:id="@+id/tvToggleControleTipo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/app_font_ui_medium"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:ellipsize="none"
                            android:text="ALTERNAR: FLW e HIDRO"
                            android:textColor="#2563EB"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.03"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_na"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="128dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bg_header_retangulo" />

        <ImageView
            android:id="@+id/bg_footer_curvo"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        app:backgroundTint="@android:color/white"
        app:contentInsetEnd="0dp"
        app:paddingBottomSystemWindowInsets="false"
        
        
        app:contentInsetStart="0dp"
        app:elevation="12dp"
        app:fabCradleMargin="10dp"
        app:fabCradleRoundedCornerRadius="18dp"
        app:fabCradleVerticalOffset="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false" />
            
            <LinearLayout
                android:id="@+id/btnIrParaHistorico"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">
                <ImageView 
                    android:layout_width="22dp" 
                    android:layout_height="22dp" 
                    android:src="@android:drawable/ic_menu_recent_history" 
                    app:tint="#94A3B8"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.bottomappbar.BottomAppBar>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/frame_pen_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Atualizar controle N.A."
        app:layout_anchor="@id/bottomAppBar"
        app:srcCompat="@android:color/transparent" 
        app:tint="@android:color/white"
        app:backgroundTint="#2563EB"
        app:elevation="6dp"
        app:maxImageSize="0dp" 
        app:fabCustomSize="56dp" />

    <ImageView
        android:id="@+id/ivPenIconForAnim"
        android:layout_width="24dp" 
        android:layout_height="24dp"
        android:src="@drawable/ic_registro_pen"
        app:tint="@android:color/white"
        android:elevation="10dp" 
        app:layout_anchor="@id/frame_pen_box"
        app:layout_anchorGravity="center" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
