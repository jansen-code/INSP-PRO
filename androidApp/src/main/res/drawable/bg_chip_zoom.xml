<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_chip_zoom.xml
    Fundo do chip que mostra o nível de zoom (ex: "180%") sobre a foto.
    Pílula escura translúcida, com leve borda branca para legibilidade
    tanto sobre áreas claras quanto escuras da imagem.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#B30F172A" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
    <corners android:radius="12dp" />
</shape>
