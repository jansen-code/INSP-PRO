<?xml version="1.0" encoding="utf-8"?>
<!--
    Gradiente usado para "derreter" o topo da lista de fotos do Cofre antes
    dela chegar embaixo do cabeçalho azul flutuante — em vez de a foto ser
    cortada de forma seca bem na borda do cabeçalho.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="#F8FAFC"
        android:centerColor="#B0F8FAFC"
        android:endColor="#00F8FAFC" />
</shape>
